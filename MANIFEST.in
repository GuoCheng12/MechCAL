include README.md LICENSE CHANGELOG.md environment.yml
recursive-include configs *.example.toml
recursive-include mechcal/profiles *.json
recursive-include docs *.md
recursive-include env *.example.sh
include env/constraints-linux-py311.txt
recursive-include tests *.py
recursive-include examples *.py
recursive-include benchmarks/photomechbench *.csv *.json *.md
recursive-include mechcal/prompts *.md
recursive-include mechcal/eval/prompts *.md
recursive-include mechcal/eval/rubrics *.json
global-exclude *.py[cod] *.local.sh *.log *.jsonl
include benchmarks/photomechbench/raw_v2_119/public_inputs.jsonl
include benchmarks/photomechbench/raw_v2_119/references.jsonl
prune outputs
prune data
prune var
prune .git
